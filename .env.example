# Copy this file to .env (which is git-ignored) and fill it in.

# Google sign-in. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application)
# with this authorised redirect URI:
#   http://localhost:5001/auth/google/callback
# Leave these empty to run without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Optional locally (one is generated in instance/);
# required in production. Make one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Production only:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
# SECURE_COOKIES=1   # site is served over https
# BEHIND_PROXY=1     # host puts a proxy in front (Render, Heroku, Railway...)
